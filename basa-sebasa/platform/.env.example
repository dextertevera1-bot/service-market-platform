# Copy to .env (or set these on your host). Anything left empty runs in safe simulation.
NODE_ENV=production
PORT=8080
BASE_URL=https://your-domain.example          # the public address of this server
DB_PATH=/data/basa.db                          # put this on a persistent disk
UPLOAD_DIR=/data/uploads
SESSION_SECRET=                                # any long random string
ADMIN_USERS=harare:CHOOSE-A-LONG-PASSWORD,dex:CHOOSE-ANOTHER-LONG-PASSWORD

# WhatsApp Cloud API (Meta Business > WhatsApp > API setup)
WHATSAPP_TOKEN=                                # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                           # App settings > Basic > App secret
WHATSAPP_VERIFY_TOKEN=                         # any word; type the same in the Meta webhook settings
WHATSAPP_OTP_TEMPLATE=                         # approved authentication template for pro log-in codes

# Payments: manual (merchant code, ops confirms) until Paynow/EcoCash API is approved, then paynow
PAYMENT_MODE=manual
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_NAME=Basa seBasa
ECOCASH_RATE=2                                 # % EcoCash charges added to the customer's total (confirm the real rate)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
