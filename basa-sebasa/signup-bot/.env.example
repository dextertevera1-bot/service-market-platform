# Copy this file to .env and fill it in. Never commit .env.
WHATSAPP_TOKEN=          # permanent System User token from Meta Business Settings
PHONE_NUMBER_ID=         # WhatsApp Manager > API Setup > Phone number ID
APP_SECRET=              # Meta app > App settings > Basic > App secret
VERIFY_TOKEN=            # any long random word; paste the same word into Meta's webhook settings
FOUNDER_PHONES=9715XXXXXXXX            # your WhatsApp number(s), country code first, comma-separated
BOT_NUMBER=2637XXXXXXXX                # the bot's own WhatsApp number, for share links
PUBLIC_URL=https://your-bot.example.com
ADMIN_KEY=               # long random word; protects the documents page
LAUNCH_DATE=15 December
OPEN_TRADES=hvac,elec,plumb,solar      # hvac, elec, plumb, solar, appl, auto, maid
DATA_DIR=./data
PORT=3000
GRAPH_VERSION=v23.0
TEMPLATE_LANG=en
